# Gorilla AI - Environment Variables Example
# Copy to .env and fill in values

# Security
SECRET_KEY=change-this-to-a-random-64-char-string
POSTGRES_PASSWORD=change-this-too

# LLM Configuration
# GPU (VRAM >= 16GB): qwen2.5:14b
# GPU (VRAM >= 24GB): qwen2.5:32b
# CPU / VRAM 8GB:     qwen2.5:7b
DEFAULT_MODEL=qwen2.5:14b
FALLBACK_MODEL=qwen2.5:7b

# Embedding
EMBED_MODEL=BAAI/bge-m3
# "cuda" for GPU, "cpu" for CPU
EMBED_DEVICE=cpu

# Logging
LOG_LEVEL=INFO

# Frontend URLs (update for production)
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000
